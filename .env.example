# Alpaca API Configuration
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview (Paper Trading)
# or https://app.alpaca.markets/live/dashboard/overview (Live Trading)

# Paper Trading API Keys (recommended for testing)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_api_secret_here

# Paper Trading Base URL (default)
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Live Trading Base URL (use with caution!)
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Data API URL (same for both paper and live)
ALPACA_DATA_URL=https://data.alpaca.markets

# Polygon API Key (optional, for additional market data)
POLYGON_API_KEY=your_polygon_api_key_here

# Application Configuration
LOG_DIR=./output
DATA_CACHE=./data_cache

# Notes:
# 1. Copy this file to .env and fill in your actual API keys
# 2. Never commit your .env file to version control
# 3. For paper trading, use your paper trading API keys
# 4. For live trading, use your live trading API keys (be very careful!)
# 5. The same API keys work for both paper and live - the base URL determines which account is used
